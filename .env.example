# Nado trading key. Testnet only — never a wallet holding real assets.
NADO_PRIVATE_KEY=0x_your_testnet_key_here

# Read-only sessions can use an address instead of a key.
# NADO_ADDRESS=0x...

# Conversational mode. Without it, bot commands still work.
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot, from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Telegram user ids allowed to trade. Empty means read-only for everyone.
TELEGRAM_ALLOWED_USER_IDS=

# Set once Nado issues a Builder ID. 0 = unattributed, no fee charged.
ROBONADO_BUILDER_ID=0

# testnet (default) or mainnet. mainnet trades real funds.
NADO_NETWORK=testnet
